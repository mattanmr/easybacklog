# Normalize line endings on commit.
# Shell scripts must always be LF so they execute correctly on Linux/macOS.
* text=auto

*.sh  text eol=lf
*.rb  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md  text eol=lf
*.env text eol=lf
Gemfile text eol=lf
Gemfile.lock text eol=lf
Rakefile text eol=lf
Procfile text eol=lf
config.ru text eol=lf

# PowerShell scripts use CRLF on Windows
*.ps1 text eol=crlf

# Vendor assets — treat as binary to prevent line-ending normalization
vendor/** binary
