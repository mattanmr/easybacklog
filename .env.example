# Environment Variables for easyBacklog
# ==============================================================================
# This file configures external services and application behavior.
# Copy this file to .env and customize as needed:
#
#   cp .env.example .env
#
# For local development, you can leave most values as-is. The application
# will work without external services configured.
# ==============================================================================

# Database Configuration
# ------------------------------------------------------------------------------
# For development, use the default values below.
# For production, use a strong randomly-generated password.
DB_PASSWORD=password
DB_USERNAME=postgres
DB_HOST=db
DB_PORT=5432

# Rails Security Tokens  [REQUIRED for stable sessions]
# ------------------------------------------------------------------------------
# SECRET_TOKEN  — Rails session secret. Must be ≥30 characters.
#                 Changing this value invalidates all existing user sessions.
# DEVISE_PEPPER — Password-hashing pepper. Must be ≥30 characters.
#                 Changing this value invalidates all existing passwords.
#
# Leave both blank to auto-generate on each container start (sessions reset
# on every restart). Set them once with a secure random value:
#
#   Linux/macOS : openssl rand -hex 64
#   Windows     : -join ((1..64) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
SECRET_TOKEN=
DEVISE_PEPPER=

# Rails Environment
RAILS_ENV=development

# Foreman Configuration
# ------------------------------------------------------------------------------
# FOREMAN enables Foreman-style process management (used in production)
# For Docker development, this is typically not needed.
FOREMAN=true

# Email Service (SendGrid)  [OPTIONAL — leave empty to disable]
# ------------------------------------------------------------------------------
# SendGrid is used to send transactional emails (signup confirmations,
# password resets, notifications).
#
# Leave blank to disable email sending (emails will be logged to the console).
#
# To enable SendGrid:
# 1. Sign up at https://sendgrid.com (free tier available)
# 2. Generate an API key in your SendGrid dashboard
# 3. Set your credentials below
SENDGRID_USERNAME=
SENDGRID_PASSWORD=

# Real-time Collaboration (Ably)  [OPTIONAL — leave empty to disable]
# ------------------------------------------------------------------------------
# Ably provides WebSocket connectivity for real-time features like:
# - Live updates when team members edit backlogs
# - Instant notifications
# - Real-time synchronization
#
# Leave blank to disable real-time features.
# The application will work in "single-user mode" without collaboration.
#
# To enable Ably:
# 1. Sign up at https://ably.com (free tier available)
# 2. Create an app in the Ably dashboard
# 3. Copy your API key here
ABLY_API_KEY=

# Monitoring Services  [OPTIONAL — leave empty to disable]
# ------------------------------------------------------------------------------
NEW_RELIC_LICENSE_KEY=

# ==============================================================================
# Note: Never commit actual credentials to version control.
# The .gitignore file excludes .env to prevent accidental commits.
#
# - For production deployments, use your hosting provider's secrets management
#   instead of a .env file (e.g., Heroku Config Vars, AWS Secrets Manager).
# ==============================================================================
