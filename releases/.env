# easyBacklog — Release Configuration
# ==============================================================================
# This file is loaded automatically by Docker Compose.
# Edit it to customize your installation, then restart with:
#
#   ./manage.sh start    (Linux/macOS)
#   .\manage.ps1 start   (Windows)
#
# Or let the setup script do it for you:
#
#   ./manage.sh setup
#
# This file is intentionally committed to source control because it contains
# only safe demo defaults. Replace the SECRET_TOKEN and DEVISE_PEPPER values
# for any non-demo deployment (the setup script offers to do this for you).
# ==============================================================================

# Database
# ------------------------------------------------------------------------------
DB_PASSWORD=password
DB_USERNAME=postgres
DB_HOST=db
DB_PORT=5432

# Rails Security Tokens
# ------------------------------------------------------------------------------
# REQUIRED: Must be at least 30 characters. Changing SECRET_TOKEN invalidates
# all existing user sessions. Changing DEVISE_PEPPER invalidates all passwords.
# Run `./manage.sh setup` to generate secure random values automatically.
SECRET_TOKEN=demo_secret_token_please_change_this_in_production
DEVISE_PEPPER=demo_devise_pepper_please_change_this_in_production

# Rails / Foreman
# ------------------------------------------------------------------------------
RAILS_ENV=development
FOREMAN=true
